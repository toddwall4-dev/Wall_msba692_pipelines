# --- Supply Chain Analytics Project Configuration ---
# 1. Create a copy of this file and rename it to .env
# 2. Fill in the values below with your specific environment details

# PostgreSQL Database Configuration
DB_USER=postgres # Replace with your database username
DB_PASSWORD=your_database_password # Replace with your database password
DB_HOST=192.168.xx.xx # Replace with your database host (e.g., localhost or IP address)
DB_PORT=5432 # Replace with your database port (default is 5432 for PostgreSQL)
DB_NAME=supplychain_db # Replace with your database name

# Federal Reserve Economic Data (FRED) API Configuration
# Get your API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_api_key_here # Replace with your FRED API key